# Copy to .env.local. Never commit real values. Public keys are intentionally browser-safe.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
# Legacy anon key fallback only; leave blank when using a publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://offtherack.vercel.app
# Optional public brand details (blank uses the existing brand defaults).
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=
# Server-only Vercel environment variables. Never prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=
NEWSLETTER_FROM=
NEWSLETTER_REPLY_TO=
NEWSLETTER_POSTAL_ADDRESS=
NEWSLETTER_UNSUBSCRIBE_SECRET=
# Enable only after the setup guide's test and unsubscribe checks pass.
NEWSLETTER_SEND_ENABLED=false

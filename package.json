{
  "name": "off-the-rack",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-browser-tests.mjs",
    "assets": "node scripts/prepare-assets.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/*.mjs\" \"tests/**/*.{ts,mjs}\" \"*.{ts,mjs,json,md}\" \"docs/*.md\"",
    "test:db": "node scripts/test-database.mjs",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "audit:secrets": "node scripts/audit-secrets.mjs",
    "analyze:bundle": "node scripts/analyze-bundle.mjs",
    "assets:social": "node scripts/create-social-assets.mjs",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/*.mjs\" \"tests/**/*.{ts,mjs}\" \"*.{ts,mjs,json,md}\" \"docs/*.md\"",
    "test:production": "node scripts/run-browser-tests.mjs --production"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.4",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0"
  },
  "type": "module"
}
